# ==================================
# Sdeume AI Environment Variables
# ==================================

# Supabase Configuration
# Note: Supabase has updated their API key naming convention (2024+)
#   - Publishable Key (formerly Anon Key): sb_publishable_xxx
#   - Secret Key (formerly Service Role Key): sb_secret_xxx
# Legacy names are still supported for backward compatibility.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client-side key (use PUBLISHABLE_KEY for new projects, ANON_KEY still works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_URL=https://your-project.supabase.co
# Server-side key (use SECRET_KEY for new projects, SERVICE_ROLE_KEY still works)
SUPABASE_SECRET_KEY=sb_secret_your-key
# Legacy: SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=sdeume-storage

# Modal AI Backend
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
# Modal endpoint URL (obtained after deploying with `modal deploy`)
MODAL_ENDPOINT_URL=https://your-workspace--sdeume-ai-comfyui-comfyuiserver-generate.modal.run

# Fal.ai LoRA Training
FAL_KEY=your-fal-api-key

# QStash (Background Job Processing)
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# Toss Payments
TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# Firebase Cloud Messaging (Web Push)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
FIREBASE_ADMIN_PRIVATE_KEY=your-firebase-admin-private-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sdeume AI

# Vercel Deployment (CI/CD)
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
